# Copy to skeepto/.env (gitignored). All values are optional.

# Server
PORT=8000
BIND_HOST=127.0.0.1

# MongoDB — use a dedicated database so sker-app data stays untouched
MONGO_URL=mongodb://localhost:27017/skeepto
MONGO_NO_AUTH=1

# Optional SMTP (otherwise the Linux host uses /etc/msmtprc via msmtp)
# SMTP_HOST=mail.skeema.fr
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@skeema.fr
# SMTP_PASS=
# SMTP_FROM=Skeepto <noreply@skeema.fr>
