# Copy to Node/Server/.env (gitignored — never commit secrets).
# Full reference: docs/Env.md

# Server
PORT=8000
BIND_HOST=127.0.0.1

# MongoDB — use a dedicated database so other apps on the same host stay untouched
MONGO_URL=mongodb://localhost:27017/skeepto
MONGO_NO_AUTH=1

# Auth (change these in production)
# JWT_SECRET=
# SKER_ADMIN_EMAIL=admin@sker.com
# SKER_ADMIN_PASSWORD=
# SKER_REGISTRATION_ENABLED=1

# Mail — required on macOS/Windows (no msmtp). Linux can omit this and use /etc/msmtprc.
# SMTP_HOST=smtp.mail.me.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@icloud.com
# SMTP_PASS=app-specific-password
# SMTP_FROM=Skeepto <you@icloud.com>
